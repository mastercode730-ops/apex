# Copy to .env.production on the server and fill in. NEVER commit the real file.
# Start:  docker compose --env-file .env.production up -d --build

# --- required ---------------------------------------------------------------
SITE_DOMAIN=apex.example.com                 # domain whose DNS A record points at the VPS
NEXT_PUBLIC_SITE_URL=https://apex.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string
SPORTMONKS_TOKEN=                            # from my.sportmonks.com > Settings > Tokens (paid cricket plan)

# --- admin / newsroom -------------------------------------------------------
ADMIN_TOKEN=                                 # 16+ random characters; unlocks /admin. Leave empty to disable.

# --- contact form email (https://resend.com) --------------------------------
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=Apex <contact@apex.example.com>   # must be a verified sender domain in Resend

# --- spam protection (Cloudflare Turnstile, free) ---------------------------
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# --- analytics & search (optional) ------------------------------------------
NEXT_PUBLIC_GA_ID=                           # GA4 measurement ID, loads only after cookie consent
GSC_VERIFICATION=                            # Search Console "HTML tag" verification token (content value only)

# --- mobile store links shown in the footer (optional, after the apps are live) ---
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# --- tuning (defaults are fine to start; raise live frequency on a paid plan) ---
SYNC_FIXTURES_SECONDS=120
SYNC_LIVE_SECONDS=10
SYNC_BACKFILL_SECONDS=60                    # how often finished matches get their full scorecard saved
CAREER_BATCH=10                              # player career records refreshed per 5-minute cycle
API_RATE_LIMIT_PER_MIN=120

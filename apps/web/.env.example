# Copy to apps/web/.env.local for development. Production uses the repo-root .env.production (see deploy/DEPLOY.md).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data source: demo (default, simulated, no setup) | sportmonks (dev: matches straight from the API) | database (production)
APEX_DATA_PROVIDER=demo
SPORTMONKS_TOKEN=              # server-side only. Never use a NEXT_PUBLIC_ prefix.
DATABASE_URL=                  # needed for APEX_DATA_PROVIDER=database, admin, and contact storage
# DATABASE_SSL=true            # for hosted Postgres that requires TLS
# PG_POOL_MAX=10

# Newsroom admin (/admin). 16+ random characters. Empty = admin disabled.
ADMIN_TOKEN=

# Contact form delivery (Resend) and optional CAPTCHA (Cloudflare Turnstile)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# Analytics / search console (optional). GA loads only after the visitor accepts cookies.
NEXT_PUBLIC_GA_ID=
GSC_VERIFICATION=

# Store links shown in the footer once the apps are published (optional)
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Public API rate limit per IP per minute
API_RATE_LIMIT_PER_MIN=120

# Advertising (Google AdSense). Leave empty = no ads. NEXT_PUBLIC_* values are baked in at build time.
NEXT_PUBLIC_ADSENSE_CLIENT=            # ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_AD_SLOT_BANNER=            # ad unit ids from AdSense > Ads > By ad unit
NEXT_PUBLIC_AD_SLOT_RECT=
NEXT_PUBLIC_AD_SLOT_INFEED=
NEXT_PUBLIC_AD_SLOT_ARTICLE=
NEXT_PUBLIC_AD_SLOT_ANCHOR=            # sticky mobile banner
NEXT_PUBLIC_ADS_PREVIEW=               # true = show labelled placeholder boxes (design review before ads are live)

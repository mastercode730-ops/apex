{
  "expo": {
    "name": "Apex Cricket",
    "slug": "apex-cricket",
    "scheme": "apex",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#080b12",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apexcricket.app"
    },
    "android": {
      "package": "com.apexcricket.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#bdf000"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#080b12"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e68f94ab-3965-42b4-be13-316b09d8afbd"
      }
    },
    "owner": "mastercode730"
  }
}

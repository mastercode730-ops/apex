# Caddy obtains and renews HTTPS certificates automatically once SITE_DOMAIN's DNS points at this server.
{$SITE_DOMAIN} {
	encode zstd gzip

	# flush_interval -1 sends Server-Sent Events (live score stream) immediately instead of buffering them.
	reverse_proxy web:3000 {
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		output stdout
		format console
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
